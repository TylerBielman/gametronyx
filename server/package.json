{
  "name": "gametronyx-scores",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gametronyx leaderboard server (scores.gametronyx.com). Game front ends post runs here; players are identified through the shared accounts API.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "npm run build && npm start"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
